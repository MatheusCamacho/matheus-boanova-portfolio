# URL pública do portfólio. Troque pelo domínio final quando publicar.
# Exemplo: https://matheusboanova.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ative somente depois de configurar o Resend no ambiente publicado.
VISIT_ALERT_ENABLED=false

# Crie uma chave em https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# Para onde o aviso de nova visita será enviado.
VISIT_ALERT_TO=matheuscamachombc@hotmail.com

# Em produção, prefira um remetente de domínio verificado no Resend.
# Exemplo: Portfolio <visitas@seudominio.com>
VISIT_ALERT_FROM="Portfolio <onboarding@resend.dev>"
